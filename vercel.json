{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/login.php" },
    { "src": "/login", "dest": "/api/login.php" },
    { "src": "/index", "dest": "/api/index.php" },
    { "src": "/tambah", "dest": "/api/tambah.php" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}
